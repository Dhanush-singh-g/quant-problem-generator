# Prefer scripts/setup.ps1: it creates independent random secrets and preserves existing files.
ENVIRONMENT=development
WEB_PORT=3000
POSTGRES_PASSWORD=replace-with-random-database-password
JWT_SECRET=replace-with-random-jwt-secret
ASSIGNMENT_SECRET=replace-with-a-different-random-secret
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=replace-with-random-administrator-password
BOOTSTRAP_ADMIN=true
AUTO_CREATE_SCHEMA=false
COOKIE_SECURE=false
COOKIE_SAMESITE=lax
CORS_ORIGINS=http://localhost:3000
RATE_LIMIT_FAIL_OPEN=false
REVEAL_RESULTS_WHILE_ACTIVE=false
ENABLE_PRACTICE_MODE=true
GENERATION_USE_AI_CONTEXT=false
GENERATION_MAX_PENDING_PER_BUCKET=5
GENERATION_QUALITY_ATTEMPTS=3
GENERATION_MAX_JOB_ATTEMPTS=3
GENERATION_RETRY_BACKOFF_SECONDS=20
GENERATION_LEASE_SECONDS=180
# Docker Compose sets DATABASE_URL and REDIS_URL for its private services.
# Native processes need explicit reachable addresses instead:
# DATABASE_URL=postgresql+psycopg://USER:PASSWORD@HOST:5432/quantforge
# REDIS_URL=redis://HOST:6379/0
# Optional Gemini context; generation works without these:
# GEMINI_API_KEY=
# GEMINI_MODEL=
# Optional Google sign-in: use the same web client ID in both variables.
# GOOGLE_CLIENT_ID=
# NEXT_PUBLIC_GOOGLE_CLIENT_ID=
